		<script is:inline>
			const scamStart = new Date('2025-01-01T00:00:00.000Z').getTime();
			const annualLossUsd = 400_000_000_000;
			const msPerYear = 365 * 24 * 60 * 60 * 1000;
			const formatter = new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				maximumFractionDigits: 0,
			});
			const billionFormatter = new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				maximumFractionDigits: 0,
			});

			const counters = document.querySelectorAll('[data-loss-counter]');
			const regularScrollStart = document.querySelector('[data-regular-scroll-start]');
			const scrollModeEnd = document.querySelector('[data-scroll-mode-end]');
			const deferredPage = document.querySelector('[data-deferred-page]');
			const pageRevealGate = document.querySelector('[data-page-reveal-gate]');
			const howHeading = document.querySelector('#how-heading');
			const howScrollButtons = document.querySelectorAll('[data-scroll-to-how]');
			const loadAt = performance.now();
			let gateTouchStartY = 0;

			const lossAt = (time) => Math.max(0, ((time - scamStart) / msPerYear) * annualLossUsd);
			const easeOut = (value) => 1 - Math.pow(1 - value, 3);

			const renderCounter = (now) => {
				const progress = Math.min(1, (now - loadAt) / 1800);
				const currentLoss = lossAt(Date.now());
				const displayValue = currentLoss * easeOut(progress);
				counters.forEach((counter) => {
					if (counter.dataset.lossCounter === 'billions') {
						const billionsLost = Math.floor(currentLoss / 1_000_000_000);
						counter.textContent = `${billionFormatter.format(billionsLost)} billion`;
						return;
					}

					counter.textContent = formatter.format(displayValue);
				});
				requestAnimationFrame(renderCounter);
			};

			if (counters.length) {
				requestAnimationFrame(renderCounter);
			}

			const daysUntilSeptember = document.querySelectorAll('[data-days-until-september]');
			if (daysUntilSeptember.length) {
				const targetDate = new Date('2026-09-30T00:00:00');
				const startOfToday = new Date();
				startOfToday.setHours(0, 0, 0, 0);
				const msPerDay = 24 * 60 * 60 * 1000;
				const daysRemaining = Math.max(
					0,
					Math.ceil((targetDate.getTime() - startOfToday.getTime()) / msPerDay),
				).toLocaleString('en-AU');
				daysUntilSeptember.forEach((counter) => {
					counter.textContent = daysRemaining;
				});
			}

			const revealPage = () => {
				if (!deferredPage) return;
				if (document.documentElement.classList.contains('page-content-revealed')) return;
				deferredPage.removeAttribute('hidden');
				document.documentElement.classList.add('page-content-revealed');
				document.documentElement.classList.remove('intro-snap-active');
			};

			const isLoadedGateActive = () => {
				if (!pageRevealGate || document.documentElement.classList.contains('page-content-revealed')) return false;
				const gateRect = pageRevealGate.getBoundingClientRect();
				return gateRect.top <= 4 && gateRect.bottom > window.innerHeight * 0.5;
			};

			window.addEventListener(
				'wheel',
				(event) => {
					if (event.deltaY > 8 && isLoadedGateActive()) {
						revealPage();
					}
				},
				{ passive: true },
			);

			window.addEventListener(
				'touchstart',
				(event) => {
					gateTouchStartY = event.touches[0]?.clientY ?? 0;
				},
				{ passive: true },
			);

			window.addEventListener(
				'touchmove',
				(event) => {
					const touchY = event.touches[0]?.clientY ?? gateTouchStartY;

					if (gateTouchStartY - touchY > 24 && isLoadedGateActive()) {
						revealPage();
					}
				},
				{ passive: true },
			);

			document.addEventListener('keydown', (event) => {
				if (![' ', 'ArrowDown', 'PageDown'].includes(event.key)) return;
				if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement?.tagName ?? '')) return;

				if (isLoadedGateActive()) {
					event.preventDefault();
					revealPage();
				}
			});

			howScrollButtons.forEach((button) => {
				button.addEventListener('click', () => {
					document.documentElement.classList.remove('intro-snap-active');
					revealPage();
					requestAnimationFrame(() => {
						howHeading?.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});
				});
			});

			const phones = document.querySelectorAll('[data-phone]');
			const peopleTrigger = document.querySelector('[data-people-trigger]');
			let ticking = false;
			let phoneReady = false;

			phones.forEach((phone) => {
				const apkTrigger = phone.querySelector('[data-apk-trigger]');
				const apkDialog = phone.querySelector('[data-apk-dialog]');
				const apkClose = phone.querySelector('[data-apk-close]');

				if (!apkTrigger || !apkDialog || !apkClose) return;

				const setScanOpen = (isOpen) => {
					phone.setAttribute('data-scan-open', isOpen ? 'true' : 'false');
					apkTrigger.setAttribute('aria-expanded', String(isOpen));
					apkDialog.setAttribute('aria-hidden', String(!isOpen));
				};

				apkTrigger.addEventListener('click', () => setScanOpen(true));
				apkClose.addEventListener('click', () => setScanOpen(false));
				apkDialog.addEventListener('click', (event) => {
					if (event.target === apkDialog) {
						setScanOpen(false);
					}
				});
			});

			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return;
				phones.forEach((phone) => {
					phone.setAttribute('data-scan-open', 'false');
					phone.querySelector('[data-apk-trigger]')?.setAttribute('aria-expanded', 'false');
					phone.querySelector('[data-apk-dialog]')?.setAttribute('aria-hidden', 'true');
				});
			});

			const updatePhoneMode = () => {
				if (!peopleTrigger) return;
				const shouldShowPeople = peopleTrigger.getBoundingClientRect().top < window.innerHeight * 0.58;
				phones.forEach((phone) => {
					if (phone.getAttribute('data-fixed-mode') === 'true') return;
					phone.setAttribute('data-mode', shouldShowPeople ? 'people' : 'chat');
				});
				if (!phoneReady) {
					phoneReady = true;
					requestAnimationFrame(() => {
						phones.forEach((phone) => phone.classList.add('is-ready'));
					});
				}
				ticking = false;
			};

			const updateIntroSnap = () => {
				if (document.documentElement.classList.contains('page-content-revealed')) {
					document.documentElement.classList.remove('intro-snap-active');
					return;
				}

				const snapEnd = scrollModeEnd || regularScrollStart;
				if (!snapEnd) return;
				const snapEndRect = snapEnd.getBoundingClientRect();
				const isInPhoneIntro = snapEndRect.bottom > window.innerHeight * 0.45;
				document.documentElement.classList.toggle('intro-snap-active', isInPhoneIntro);
			};

			const requestPhoneUpdate = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updatePhoneMode();
					updateIntroSnap();
				});
			};

			const newsPreviewCards = document.querySelectorAll('[data-news-preview-card]');
			const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

			const moveNewsPreview = (event, preview) => {
				const gap = 18;
				const padding = 12;
				const rect = preview.getBoundingClientRect();
				let left = event.clientX + gap;
				let top = event.clientY + gap;

				if (left + rect.width + padding > window.innerWidth) {
					left = event.clientX - rect.width - gap;
				}

				if (top + rect.height + padding > window.innerHeight) {
					top = event.clientY - rect.height - gap;
				}

				preview.style.transform = `translate3d(${clamp(left, padding, window.innerWidth - rect.width - padding)}px, ${clamp(top, padding, window.innerHeight - rect.height - padding)}px, 0)`;
			};

			newsPreviewCards.forEach((card) => {
				const preview = card.querySelector('[data-news-preview]');
				if (!preview) return;

				card.addEventListener('pointerenter', (event) => {
					moveNewsPreview(event, preview);
					preview.classList.remove('invisible', 'opacity-0');
					preview.classList.add('opacity-100');
				});

				card.addEventListener('pointermove', (event) => {
					moveNewsPreview(event, preview);
				});

				card.addEventListener('pointerleave', () => {
					preview.classList.add('invisible', 'opacity-0');
					preview.classList.remove('opacity-100');
				});
			});

			const lightbox = document.querySelector('#image-lightbox');
			const lightboxImage = document.querySelector('[data-lightbox-image]');
			const lightboxClose = document.querySelector('[data-lightbox-close]');
			const lightboxTriggers = document.querySelectorAll('[data-lightbox-trigger]');

			const getVisibleImage = (trigger) => {
				const images = Array.from(trigger.querySelectorAll('img'));
				return images.find((image) => getComputedStyle(image).display !== 'none') ?? images[0];
			};

			lightboxTriggers.forEach((trigger) => {
				trigger.addEventListener('click', (event) => {
					if (trigger instanceof HTMLAnchorElement && !(event.target instanceof Element && event.target.closest('img'))) {
						return;
					}

					const image = getVisibleImage(trigger);
					if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement) || !image) return;

					event.preventDefault();
					lightboxImage.src = image.currentSrc || image.src;
					lightboxImage.alt = image.alt;

					if (!lightbox.open) {
						lightbox.showModal();
					}
				});
			});

			lightboxClose?.addEventListener('click', () => {
				if (lightbox instanceof HTMLDialogElement) {
					lightbox.close();
				}
			});

			lightbox?.addEventListener('click', (event) => {
				if (event.target === lightbox && lightbox instanceof HTMLDialogElement) {
					lightbox.close();
				}
			});

			requestPhoneUpdate();
			window.addEventListener('scroll', requestPhoneUpdate, { passive: true });
			window.addEventListener('resize', requestPhoneUpdate);
		</script>
		<script>
			import { annotate } from 'rough-notation';

			const annotateOnView = (target, options) => {
				const annotation = annotate(target, {
					type: 'underline',
					strokeWidth: 3,
					padding: 2,
					animationDuration: 850,
					...options,
				});

				const showAnnotation = () => {
					annotation.show();
				};

				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver(
						(entries) => {
							if (!entries.some((entry) => entry.isIntersecting)) return;
							showAnnotation();
							observer.disconnect();
						},
						{ threshold: 0.35 },
					);

					observer.observe(target);
				} else {
					showAnnotation();
				}
			};

			const runRoughNotation = () => {
				const rootStyles = getComputedStyle(document.documentElement);
				const countdownNumber = document.querySelector('[data-rough-countdown-underline]');
				const tldrHeading = document.querySelector('[data-rough-tldr-underline]');

				if (countdownNumber) {
					const rose = rootStyles.getPropertyValue('--rose').trim();
					annotateOnView(countdownNumber, {
						color: rose || '#c84e55',
					});
				}

				if (tldrHeading) {
					const amber = rootStyles.getPropertyValue('--amber').trim();
					const tldrAnnotation = annotate(tldrHeading, {
						type: 'underline',
						color: amber || '#f4c542',
						strokeWidth: 4,
						padding: 3,
						animate: false,
						animationDuration: 0,
					});
					tldrAnnotation.show();
				}
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', runRoughNotation, { once: true });
			} else {
				runRoughNotation();
			}
		</script>
		<script>
			import confetti from 'canvas-confetti';

			const fireTldrConfetti = (target) => {
				const rect = target.getBoundingClientRect();
				const source = {
					x: rect.left + rect.width / 2,
					y: rect.top + rect.height / 2,
				};
				const origin = {
					x: source.x / window.innerWidth,
					y: source.y / window.innerHeight,
				};
				const angleToCenter =
					(Math.atan2(window.innerHeight / 2 - source.y, window.innerWidth / 2 - source.x) * 180) /
					Math.PI;
				const angle = (360 - angleToCenter) % 360;

				void confetti({
					angle,
					particleCount: 86,
					spread: 48,
					startVelocity: 38,
					scalar: 0.92,
					origin,
					colors: ['#fbfbf4', '#3ddc84', '#e5b75a', '#2077b4', '#151611'],
					disableForReducedMotion: true,
				});
			};

			const wireTldrConfetti = () => {
				document.querySelectorAll('.tldr-help-check').forEach((checkbox) => {
					checkbox.addEventListener('change', (event) => {
						if (!(event.currentTarget instanceof HTMLInputElement) || !event.currentTarget.checked) return;
						fireTldrConfetti(event.currentTarget);
					});
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', wireTldrConfetti, { once: true });
			} else {
				wireTldrConfetti();
			}
		</script>
	</body>
</html>
