---
import { Font } from 'astro:assets';
import articleBitdefenderImage from '@/assets/article-bitdefender.png';
import acluPreviewImage from '@/assets/placeholder-aclu.png';
import guardianPreviewImage from '@/assets/placeholder-guardian.png';
import techradarPreviewImage from '@/assets/placeholder-techradar.png';
import discordClippyDarkImage from '@/assets/discord-clippy-dark.png';
import discordClippyLightImage from '@/assets/discord-clippy-light.png';
import tldrConversationImage from '@/assets/tldr-geek-seagull.jpeg';
import tldrOnlineOutreachImage from '@/assets/post-malone.jpg';
import ActionChecklist from '@/components/action-checklist';
import CyberdeckScrapbook from '@/components/cyberdeck-scrapbook.astro';
import EventInterestInvite from '@/components/event-interest-invite.astro';
import OpenAppShowcase from '@/components/open-app-showcase.astro';
import PhoneMockup from '@/components/phone-mockup.astro';
import RepresentativeVoting from '@/components/representative-voting.astro';
import '@/styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.svg"
		/>
		<link
			rel="icon"
			href="/favicon.ico"
		/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<meta
			name="generator"
			content={Astro.generator}
		/>
		<meta
			name="description"
			content="Android can be safer without becoming smaller. Help build the open path."
		/>
		<meta
			property="og:title"
			content="helpsaveandroid.org"
		/>
		<meta
			property="og:description"
			content="Android can be safer without becoming smaller. Help build the open path."
		/>
		<Font cssVariable="--font-serif" />
		<title>helpsaveandroid.org</title>
	</head>
	<body>
		<a
			href="#top"
			class="side-wordmark text-(--muted)/50! hover:text-(--ink)! group"
			aria-label="helpsaveandroid.org home"
		>
			helpsaveandroid<span class="group-hover:text-(--accent) transition-colors">.</span>org
		</a>

		<main
			id="top"
			class="relative overflow-x-clip"
		>
			<section
				class="relative mx-auto grid max-w-7xl px-5 sm:px-8 md:grid-cols-[minmax(0,1fr)_minmax(19rem,27rem)] md:gap-16 md:px-12 xl:gap-24"
			>
				<div class="relative z-10">
					<section
						class="snap-panel relative z-10 flex min-h-screen flex-col justify-center pb-16 pt-8 sm:pt-10 md:items-center md:pb-24 md:pt-24"
					>
						<div class="max-w-3xl">
							<p class="type-body italic text-(--ink)">since the beginning of last year,</p>
							<div
								class="type-heading mt-5 max-w-full whitespace-nowrap text-(--ink) tabular-nums"
								data-loss-counter
							>
								$0
							</div>
							<p class="type-body text-end lg:text-start lg:pl-84 mt-6 max-w-2xl italic text-(--ink)">
								was ruined and lost to scams.
							</p>
							<div class="type-body mt-11 max-w-2xl space-y-5 text-(--ink)">
								<p>
									google<sup class="footnote-ref"><a href="#fn-google">1</a></sup> is trying to fix this,
									but they're doing so by making everyone identify themselves.
								</p>
								<p class="text-(--ink)">what might a better approach, and a better android look like?</p>
							</div>
						</div>

						<div class="pointer-events-none mt-12 flex w-full justify-center md:hidden">
							<PhoneMockup
								size="compact"
								mode="chat"
								fixedMode
							/>
						</div>
					</section>

					<section
						id="solution"
						class="snap-panel relative z-10 flex min-h-screen flex-col justify-center pb-16 pt-12 sm:pt-16 md:items-center md:py-24"
						data-people-trigger
					>
						<div class="max-w-3xl">
							<p class="type-subheading max-w-[38rem] text-balance text-(--ink)">
								what might a better approach, and a better android look like?
							</p>
						</div>

						<div class="pointer-events-none mt-12 flex w-full justify-center md:hidden">
							<PhoneMockup
								size="compact"
								mode="people"
								fixedMode
							/>
						</div>
					</section>
				</div>

				<aside class="pointer-events-none sticky top-0 hidden h-screen items-center justify-center md:flex">
					<PhoneMockup />
				</aside>
			</section>

			<section
				class="tldr-snap-panel relative z-10 min-h-screen border-t border-(--line) bg-(--paper-raised) px-5 pb-20 pt-20 sm:px-8 sm:pt-24 lg:px-12"
			>
				<div class="absolute right-5 top-5 z-20 flex max-w-[calc(100%-2.5rem)] flex-col items-end gap-3 text-right sm:right-8 sm:top-8 sm:flex-row sm:items-center lg:right-12">
					<p class="text-[clamp(1.05rem,1.45vw,1.28rem)] leading-tight font-medium text-(--ink)">
						<span
							class="inline-block pr-1 font-black tabular-nums text-(--ink)"
							data-days-until-september
							data-rough-countdown-underline
						>
							114</span
						>
						<span class="font-semibold">days until googlegeddon</span>
					</p>
					<button
						type="button"
						class="inline-flex min-h-10 items-center justify-center rounded-full border border-(--rose) px-4 py-2 text-[clamp(0.92rem,1.1vw,1rem)] leading-none font-semibold whitespace-nowrap text-(--rose) transition-colors hover:bg-(--rose) hover:text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-(--ink)"
						data-scroll-to-how
					>
						learn how you can help
					</button>
				</div>
			<br><br><br><br>
				<div class="mx-auto max-w-3xl">
					<section
						aria-labelledby="tldr-heading"
						class="tldr-section type-body text-(--ink)"
					>
						<h2
							id="tldr-heading"
							class="tldr-heading type-subheading inline-block text-(--ink)"
							data-rough-tldr-underline
						>
							tldr
						</h2>
						<div class="mt-10">
							<p>
								<span
									class="font-semibold tabular-nums"
									data-loss-counter="billions"
								>
									$0 billion</span
								>
								lost to scams.
							</p>
							<p class="mt-3">
								Google's fix is about locking Android down – forcing real names and centralising control.
							</p>
							<p class="mt-14">Let's think different.</p>
							<p class="mt-6">
								We propose an on-device open language model, stopping scams before they reach you.
							</p>
							<p class="mt-3">
								Our approach will cause the immediate end of scams, since the tech for doing so exists
								<em>right now</em> – along with creating an open app store for everyone.
							</p>
						</div>

						<div class="mt-20">
							<h3 class="text-[clamp(1.35rem,2vw,1.82rem)] leading-tight font-semibold text-(--ink)">
								You can help spread this by
							</h3>
							<ul class="tldr-help-list mt-10 grid gap-5 sm:grid-cols-3 sm:gap-6">
								<li class="tldr-help-item">
									<input
										type="checkbox"
										class="tldr-help-check"
										aria-label="Mark telling a geek at work or school complete"
									/>
									<button
										type="button"
										class="lightbox-trigger"
										data-lightbox-trigger
										aria-label="Open example conversation image"
									>
										<img
											src={tldrConversationImage.src}
											alt=""
											loading="lazy"
											decoding="async"
											class="tldr-help-image tldr-help-image--geek"
										/>
									</button>
									<p class="tldr-help-copy">
										<span class="tldr-help-title">telling&nbsp;a&nbsp;geek&nbsp;at work&nbsp;or&nbsp;school</span>
									</p>
								</li>
								<li class="tldr-help-item">
									<input
										type="checkbox"
										class="tldr-help-check"
										aria-label="Mark adding to your Discord bio complete"
									/>
									<button
										type="button"
										class="lightbox-trigger"
										data-lightbox-trigger
										aria-label="Open Discord bio image"
									>
										<span
											class="tldr-help-image-card"
											aria-hidden="true"
										>
											<img
												src={discordClippyLightImage.src}
												alt=""
												loading="lazy"
												decoding="async"
												class="tldr-help-image tldr-help-image--theme tldr-help-image--light"
											/>
											<img
												src={discordClippyDarkImage.src}
												alt=""
												loading="lazy"
												decoding="async"
												class="tldr-help-image tldr-help-image--theme tldr-help-image--dark"
											/>
										</span>
									</button>
									<p class="tldr-help-copy">
										<span class="tldr-help-title">adding&nbsp;to&nbsp;your discord&nbsp;bio</span>
									</p>
								</li>
								<li class="tldr-help-item tldr-help-item--online">
									<input
										type="checkbox"
										class="tldr-help-check"
										aria-label="Mark reaching out to people online complete"
									/>
									<button
										type="button"
										class="lightbox-trigger"
										data-lightbox-trigger
										aria-label="Open online outreach image"
									>
										<img
											src={tldrOnlineOutreachImage.src}
											alt=""
											loading="lazy"
											decoding="async"
											class="tldr-help-image tldr-help-image--online"
										/>
									</button>
									<p class="tldr-help-copy">
										<span class="tldr-help-title">reaching&nbsp;out&nbsp;to people&nbsp;online</span>
									</p>
								</li>
							</ul>
							<p class="mt-10">
								You're welcome to
								<a
									href="https://discord.gg/gXBAggx9UG"
									target="_blank"
									rel="noreferrer"
									class="footer-contact-link footer-contact-link--discord tldr-discord-link"
								>
									<span>join our discord</span>
									<span
										class="footer-contact-icon"
										aria-hidden="true"
									>
										<svg
											viewBox="0 0 24 24"
											class="footer-contact-glyph size-3.5"
											fill="currentColor"
										>
											<path
												d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.86-.61 1.25a18.3 18.3 0 0 0-5.48 0 13 13 0 0 0-.62-1.25.08.08 0 0 0-.08-.04A19.7 19.7 0 0 0 3.68 4.37a.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.05 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .09-.03 14.1 14.1 0 0 0 1.22-1.99.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13c.13-.09.25-.19.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01c.12.1.25.2.37.29a.08.08 0 0 1-.01.13 12.3 12.3 0 0 1-1.87.89.08.08 0 0 0-.04.11c.36.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42Zm7.98 0c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z"
											></path>
										</svg>
									</span>
								</a>
								too.
							</p>
							<p class="mt-4">
							Above all, make some noise – we only need to make it easier for Google to do the ethical
								thing.
							</p>
						</div>

						<div class="mt-20">
							<p>
								In
								<span
									class="font-semibold tabular-nums"
									data-days-until-september
								>
									114</span
								>
								days the future of your phone gets decided.
							</p>
							<p class="mt-8">We believe that future can be safe, private, and fun.</p>
							<p class="mt-2">Your phone is a computer you bought – and it should be yours.</p>
							<p class="mt-8">
								After all, if everyone had their own computer in their pocket, what might we solve next?
							</p>
							<br><br>
							<div class="scroll-learn-more-cue-snap mt-14">
								<p class="text-center text-[clamp(1rem,1.2vw,1.1rem)] font-semibold text-(--muted)">
									scroll to learn more
								</p>
								<div
									class="scroll-cue-arrow mx-auto mt-4"
									aria-hidden="true"
								></div>
							</div>
						</div>
					</section>
				</div>
			</section>

			<section
				class="page-reveal-gate scroll-learn-more-snap relative z-10 bg-(--paper-raised) px-5 pb-0 pt-12 sm:px-8 sm:pt-14 lg:px-12"
				data-page-reveal-gate
				data-scroll-mode-end
			>
			<br><br><br><br><br><br><br>
				<div class="page-reveal-gate__content mx-auto max-w-3xl">
					<p class="type-body text-(--ink)">
						we propose creating a local and open language model to detect scams, for everyone.
					</p>

					<div class="mt-16 mb-0 grid gap-4 lg:-ml-36 lg:w-[calc(100%+18rem)] lg:grid-cols-2">
						<div
							class="grid min-h-80 place-items-center rounded-lg border border-dashed border-(--line-strong) bg-(--paper) p-6 text-center shadow-[0_1.2rem_2.4rem_var(--page-shadow)]"
						>
							<p class="type-subheading text-(--muted)">[anti-scam model]</p>
						</div>
						<div
							class="grid min-h-80 place-items-center rounded-lg border border-dashed border-(--line-strong) bg-(--paper) p-6 text-center shadow-[0_1.2rem_2.4rem_var(--page-shadow)]"
						>
							<p class="type-subheading text-(--muted)">[an open app store]</p>
						</div>
					</div>

					<div class="type-body mt-16 text-(--ink)">
						<p>
							you can run local language models on your phone. so, you could have a model on your phone
							protecting you from ever sophisticated scamming attempts<sup class="footnote-ref"
								><a href="#fn-scam-attempts">2</a></sup
							>.
						</p>
						<p class="mt-16">
							everyone can contribute to the model, and a fun task is seeing how close you can get to scamming
							– you get a score on how close you got.
						</p>
						<p
							class="mt-3 pl-6 text-[clamp(1rem,1.25vw,1.12rem)] leading-relaxed italic text-(--muted) sm:pl-12"
						>
							(but, the model is so good that you never really get close; like 20% close is a really good
							score)
						</p>
						<br><br>
						<p class="mt-16">also, what about creating a "World Wide Web" where:</p>
						<ul class="mt-5 ml-16 grid list-disc gap-1">
							<li>developers can give away useful and open apps for free</li>
							<li>using open source code</li>
							<li>with automatic filtering</li>
						</ul>
						<p class="mt-5">and that are personally checked by actual people?</p>
					</div>
				</div>
			</section>

			<section
				class="relative z-10 bg-(--paper-raised) px-5 pb-28 pt-0 sm:px-8 sm:pt-0 lg:px-12"
				data-deferred-page
				data-regular-scroll-start
				hidden
			>
				<div class="mx-auto max-w-3xl">
					<div
						class="my-16 grid min-h-96 place-items-center rounded-lg border border-dashed border-(--line-strong) bg-(--paper) p-6 text-center shadow-[0_1.2rem_2.4rem_var(--page-shadow)] lg:-ml-36 lg:w-[calc(100%+18rem)]"
					>
						<p class="type-subheading text-(--muted)">[a world wide web of open-source applications]</p>
					</div>

					<div class="type-body mb-16 text-(--ink)">
						<p>we think that ending scams becomes possible with open and transparent software.</p>
						<p class="mt-3">
							this means that companies shouldn't create their own limits on you using something that you own
							and paid for.
						</p>
						<p class="mt-10">
							the great developments on the internet happened because people could play around with stuff, and
							it's lead to a lot of innovation, too.
						</p>
						<ol class="footnotes mt-10">
							<li id="fn-google">
								<span class="footnote-number">[1]</span>
								small mum and pop shop, Google.
							</li>
							<li id="fn-scam-attempts">
								<span class="footnote-number">[2]</span>
								like people cloning your voice, or crafting a fake lover, or convincing you to invest in
								something that never existed.
							</li>
						</ol>
						<p class="mt-24">
							we think that new developments in local language models (that you can run on your phone or
							laptop yourself) can keep people safe.
						</p>
						<p class="mt-3"><br>
							there's just too many scams to pay attention to nowadays; <br />any approach to solving them
							has to be something that everyone can work towards together.
						</p>
						<p class="mt-48">
							apart from choosing names for an open app store, there's also some technical problems to work
							through too.
						</p>
						<p class="mt-5">for example:</p>
						<ul class="mt-5 ml-16 grid list-disc gap-6">
							<li>
								while most new devices can run local language models, what about low-powered phones, like
								those found in developing and emerging countries?
							</li>
							<li>
								also, within developing countries: people, including tourists, have been abducted –
								<em>abducted</em> – or coerced and forced to work in scamming operations.
								<span class="mt-3 block">
									how might we make sure that people are released, and are going to be safe?
								</span>
							</li>
							<li>
								and if you're going to have an open app store, it needs to be easy to install, cost nothing to
								run the infrastructure, and require no logins or accounts
							</li>
							<li>
								and, if developers can choose to be anonymous, how do you stop bad actors from spamming or
								lying, and create governance through consensus?
							</li>
						</ul>
						<p class="mt-10">
							scamming and technology are both really big industries – we have some ideas, but
						</p>
						<p class="mt-5 pl-8 font-bold">honestly, it does come down a bit to public relations.</p>
						<p class="mt-20">
							it seems like we're up against a giant megacorporation, but as far as we're concerned, we're not
							really against them (yet).
						</p>
						<br />
						<p class="mt-5">after all, nobody likes getting scammed – including google.</p>
					</div>

					<figure class="my-16 lg:-ml-36 lg:w-[calc(100%+18rem)]">
						<button
							type="button"
							class="lightbox-trigger"
							data-lightbox-trigger
						>
							<img
								src={articleBitdefenderImage.src}
								alt="Screenshot of a Bitdefender article about a phishing swindle that conned Google and Facebook."
								loading="lazy"
								decoding="async"
								class="block w-full rounded-lg border border-(--line) bg-white shadow-[0_1.2rem_2.4rem_var(--page-shadow)]"
							/>
						</button>
						<figcaption class="mt-4 text-[clamp(1rem,1.25vw,1.12rem)] leading-relaxed italic text-(--muted)">
							source:
							<a
								href="https://www.bitdefender.com/en-us/blog/hotforsecurity/the-phishing-swindle-that-conned-100-million-out-of-google-and-facebook"
								target="_blank"
								rel="noreferrer"
								class="underline decoration-(--accent-strong) decoration-2 underline-offset-4 hover:decoration-4"
							>
								bitdefender article</a
							>
						</figcaption>
					</figure>

					<div class="type-body mb-16 text-(--ink)">
						<p >it happens.</p>
						<br><br><br>
						<p class="mt-10">
							it's more that we're against the pretty common myth of "you can have <em>safety</em>, or you can
							have <em>privacy</em>."
						</p>
						<p class="mt-5">
							we know the <strong><em>simple fact that both of these things can be true.</em></strong>
						</p><br>
						<h2 class="type-subheading mt-28 text-center text-(--ink)">
							What might something else look like?
						</h2>
						<p class="mt-12">as geeks, we see the basic problem as this:</p>
						<p class="mt-8">
							Instead of mandating that android developers identify themselves, solving the problem must be
						</p>
						<blockquote class="mt-5 border-l-2 border-(--accent-strong) pl-6">
							<ol class="grid gap-1 text-(--ink)">
								<li>1. anonymous</li>
								<li>2. safe for grandma</li>
								<li>3. easy for geeks.</li>
							</ol>
						</blockquote>
						<div
							class="mt-16 overflow-hidden rounded-lg border border-(--line) bg-(--paper) shadow-[0_0.6rem_1.4rem_var(--page-shadow)] lg:-ml-20 lg:w-[calc(100%+10rem)]"
						>
							<div class="overflow-x-auto">
								<table
									class="w-full min-w-[48rem] border-separate border-spacing-0 text-left text-[clamp(1.08rem,1.35vw,1.28rem)] leading-relaxed"
								>
									<thead>
										<tr class="bg-(--paper-raised) text-(--ink)">
											<th class="w-1/2 border-b border-(--line) px-4 py-2 font-semibold">
												our current best approach is
											</th>
											<th class="w-1/2 border-b border-l border-(--line) px-4 py-2 font-semibold">
												compared with google
											</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td class="border-b border-(--line) px-4 py-3 align-top">
												create an open app store where larger models verify apps using a consensus
												mechanism and human review.
											</td>
											<td class="border-b border-l border-(--line) px-4 py-3 align-top">
												all developers inside and outside the play store need to identify themselves
												using government identification.
											</td>
										</tr>
										<tr>
											<td class="border-b border-(--line) px-4 py-3 align-top">
